#version 320 es
#ifdef GL_ARB_shader_draw_parameters
#extension GL_ARB_shader_draw_parameters : enable
#endif

layout(binding = 0, std140) uniform type_Matrices
{
    layout(row_major) mat4 model;
    layout(row_major) mat4 view;
    layout(row_major) mat4 projection;
} Matrices;

layout(binding = 3, std430) readonly buffer type_StructuredBuffer_mat4v4float
{
    layout(row_major) mat4 _m0[];
} instanceModels;

layout(location = 0) in vec3 in_var_POSITION;
layout(location = 1) in vec3 in_var_NORMAL;
#ifdef GL_ARB_shader_draw_parameters
#define SPIRV_Cross_BaseInstance gl_BaseInstanceARB
#else
uniform int SPIRV_Cross_BaseInstance;
#endif
layout(location = 0) out vec3 out_var_TEXCOORD0;

mat4 spvWorkaroundRowMajor(mat4 wrap) { return wrap; }

void main()
{
    gl_Position = ((vec4(in_var_POSITION, 1.0) * instanceModels._m0[uint((gl_InstanceID + SPIRV_Cross_BaseInstance))]) * spvWorkaroundRowMajor(Matrices.view)) * spvWorkaroundRowMajor(Matrices.projection);
    out_var_TEXCOORD0 = in_var_NORMAL * mat3(instanceModels._m0[uint((gl_InstanceID + SPIRV_Cross_BaseInstance))][0].xyz, instanceModels._m0[uint((gl_InstanceID + SPIRV_Cross_BaseInstance))][1].xyz, instanceModels._m0[uint((gl_InstanceID + SPIRV_Cross_BaseInstance))][2].xyz);
}

