#version 320 es
precision mediump float;
precision highp int;

layout(binding = 1, std140) uniform type_MaterialData
{
    highp vec4 baseColor;
} MaterialData;

layout(binding = 2, std140) uniform type_LightData
{
    highp vec3 lightDirection;
} LightData;

layout(location = 0) in highp vec3 in_var_TEXCOORD0;
layout(location = 0) out highp vec4 out_var_SV_Target;

void main()
{
    highp float _32 = dot(normalize(in_var_TEXCOORD0), -normalize(LightData.lightDirection));
    out_var_SV_Target = vec4(MaterialData.baseColor.xyz * (isnan(0.4000000059604644775390625) ? _32 : (isnan(_32) ? 0.4000000059604644775390625 : max(_32, 0.4000000059604644775390625))), MaterialData.baseColor.w);
}

